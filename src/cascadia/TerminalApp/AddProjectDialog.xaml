<ContentDialog x:Class="TerminalApp.AddProjectDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               CloseButtonText="Cancel"
               DefaultButton="Primary"
               PrimaryButtonText="Add"
               Title="Add Project"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ContentDialogSmokeBrush" Color="#99000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ContentDialogSmokeBrush" Color="#99000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ContentDialogSmokeBrush" Color="#99000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <StackPanel x:Name="AddProjectContentPanel"
                MinWidth="420"
                Spacing="12">

        <!-- Project Name -->
        <TextBlock FontWeight="SemiBold"
                   Text="Project Name" />
        <TextBox x:Name="ProjectNameBox"
                 PlaceholderText="My App / 내 앱 / 我的应用" />

        <!-- Folder Path -->
        <TextBlock FontWeight="SemiBold"
                   Text="Folder Path" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderPathBox"
                     Grid.Column="0"
                     PlaceholderText="C:\Projects\MyApp" />
            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Click="_BrowseFolderClicked"
                    Content="..." />
        </Grid>

        <!-- Project Type -->
        <TextBlock FontWeight="SemiBold"
                   Text="Type" />
        <ComboBox x:Name="ProjectTypeBox"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="0">
            <ComboBoxItem Content="Web (Browser)" />
            <ComboBoxItem Content="App" />
            <ComboBoxItem Content="Cowork (AI Workflow)" />
        </ComboBox>

        <!-- Default AI Tool -->
        <TextBlock FontWeight="SemiBold"
                   Text="Default AI Tool" />
        <ComboBox x:Name="AIToolBox"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="0">
            <ComboBoxItem Content="Claude Code (Anthropic)" />
            <ComboBoxItem Content="Codex CLI (OpenAI)" />
            <ComboBoxItem Content="Gemini (Google)" />
            <ComboBoxItem Content="None" />
        </ComboBox>

        <!-- Color Scheme -->
        <TextBlock FontWeight="SemiBold"
                   Text="Terminal Color Scheme" />
        <ComboBox x:Name="ColorSchemeBox"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="0">
            <ComboBoxItem Content="Default" />
            <ComboBoxItem Content="CTux Dark" />
            <ComboBoxItem Content="CTux Light" />
            <ComboBoxItem Content="Campbell" />
            <ComboBoxItem Content="One Half Dark" />
            <ComboBoxItem Content="One Half Light" />
            <ComboBoxItem Content="Solarized Dark" />
            <ComboBoxItem Content="Solarized Light" />
            <ComboBoxItem Content="Tango Dark" />
            <ComboBoxItem Content="Tango Light" />
        </ComboBox>

    </StackPanel>
</ContentDialog>
