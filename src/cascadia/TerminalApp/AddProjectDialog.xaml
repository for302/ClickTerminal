<ContentDialog x:Class="TerminalApp.AddProjectDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               CloseButtonText="Cancel"
               PrimaryButtonText="Add"
               Title="Add Project"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ContentDialogSmokeBrush" Color="#99000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ContentDialogSmokeBrush" Color="#99000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ContentDialogSmokeBrush" Color="#99000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <StackPanel x:Name="AddProjectContentPanel"
                MinWidth="420"
                Spacing="12">

        <!-- Project Name -->
        <TextBlock FontWeight="SemiBold"
                   Text="Project Name" />
        <TextBox x:Name="ProjectNameBox"
                 GotFocus="_OnTextBoxGotFocus"
                 PlaceholderText="My App / 내 앱 / 我的应用" />

        <!-- Folder Path -->
        <TextBlock FontWeight="SemiBold"
                   Text="Folder Path" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderPathBox"
                     Grid.Column="0"
                     GotFocus="_OnTextBoxGotFocus"
                     PlaceholderText="C:\Projects\MyApp" />
            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Click="_BrowseFolderClicked"
                    Content="..." />
        </Grid>

        <!-- Project Type -->
        <TextBlock FontWeight="SemiBold"
                   Text="Type" />
        <ComboBox x:Name="ProjectTypeBox"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="0">
            <ComboBoxItem Content="Web (Browser)" />
            <ComboBoxItem Content="App" />
            <ComboBoxItem Content="Cowork (AI Workflow)" />
        </ComboBox>

        <!-- Default AI Tool -->
        <TextBlock FontWeight="SemiBold"
                   Text="Default AI Tool" />
        <ComboBox x:Name="AIToolBox"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="0">
            <ComboBoxItem Content="Claude Code (Anthropic)" />
            <ComboBoxItem Content="Codex CLI (OpenAI)" />
            <ComboBoxItem Content="Gemini (Google)" />
            <ComboBoxItem Content="None" />
        </ComboBox>

        <!-- AI Start Command -->
        <TextBlock FontWeight="SemiBold"
                   Text="AI Start Command" />
        <TextBox x:Name="AIStartCommandBox"
                 GotFocus="_OnTextBoxGotFocus"
                 PlaceholderText="claude" />
        <CheckBox x:Name="AutoStartAIBox"
                  Content="터미널 시작시 바로 실행"
                  Margin="0,2,0,0"/>

        <!-- URLs -->
        <TextBlock FontWeight="SemiBold"
                   Margin="0,8,0,0"
                   Text="URLs" />
        <TextBlock FontSize="11"
                   Opacity="0.65"
                   Text="Dev URL" />
        <TextBox x:Name="DevUrlBox"
                 GotFocus="_OnTextBoxGotFocus"
                 PlaceholderText="http://localhost:3000" />
        <TextBlock FontSize="11"
                   Margin="0,4,0,0"
                   Opacity="0.65"
                   Text="Deploy URL" />
        <TextBox x:Name="DeployUrlBox"
                 GotFocus="_OnTextBoxGotFocus"
                 PlaceholderText="https://my-app.example.com" />
        <TextBlock FontSize="11"
                   Margin="0,4,0,0"
                   Opacity="0.65"
                   Text="Git URL" />
        <TextBox x:Name="GitUrlBox"
                 GotFocus="_OnTextBoxGotFocus"
                 PlaceholderText="https://github.com/user/repo" />

    </StackPanel>
</ContentDialog>
