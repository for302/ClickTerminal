<UserControl x:Class="TerminalApp.ContextMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SegEmptyBrush"
                         Color="{ThemeResource SystemBaseMediumColor}"
                         Opacity="0.25" />
        <SolidColorBrush x:Key="SegWarnBrush"
                         Color="#F0A500" />
        <SolidColorBrush x:Key="SegCritBrush"
                         Color="#E81123" />
    </UserControl.Resources>

    <StackPanel x:Name="SegmentPanel"
                Orientation="Horizontal"
                Spacing="1"
                VerticalAlignment="Center">
        <Rectangle x:Name="Seg0"
                   Width="5"
                   Height="12"
                   Fill="{StaticResource SegEmptyBrush}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle x:Name="Seg1"
                   Width="5"
                   Height="12"
                   Fill="{StaticResource SegEmptyBrush}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle x:Name="Seg2"
                   Width="5"
                   Height="12"
                   Fill="{StaticResource SegEmptyBrush}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle x:Name="Seg3"
                   Width="5"
                   Height="12"
                   Fill="{StaticResource SegEmptyBrush}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle x:Name="Seg4"
                   Width="5"
                   Height="12"
                   Fill="{StaticResource SegEmptyBrush}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle x:Name="Seg5"
                   Width="5"
                   Height="12"
                   Fill="{StaticResource SegEmptyBrush}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle x:Name="Seg6"
                   Width="5"
                   Height="12"
                   Fill="{StaticResource SegEmptyBrush}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle x:Name="Seg7"
                   Width="5"
                   Height="12"
                   Fill="{StaticResource SegEmptyBrush}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle x:Name="Seg8"
                   Width="5"
                   Height="12"
                   Fill="{StaticResource SegEmptyBrush}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle x:Name="Seg9"
                   Width="5"
                   Height="12"
                   Fill="{StaticResource SegEmptyBrush}"
                   RadiusX="1"
                   RadiusY="1" />
    </StackPanel>
</UserControl>
