<ContentDialog x:Class="TerminalApp.LayoutPickerDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:local="using:TerminalApp"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               Title="Layout Manager"
               PrimaryButtonText="Apply"
               SecondaryButtonText="Save"
               CloseButtonText="Cancel"
               DefaultButton="Primary"
               PrimaryButtonClick="OnApplyClicked"
               SecondaryButtonClick="OnSaveClicked"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <!-- Allow the dialog to be wider than the default ~548px cap -->
        <x:Double x:Key="ContentDialogMaxWidth">9999</x:Double>

        <Style x:Key="ShapeCellStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        </Style>
    </ContentDialog.Resources>

    <!-- Two-column layout: left = saved list, right = editor -->
    <Grid Width="700" MinHeight="400">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT: Saved Layouts list ===== -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,4,14,4">
            <StackPanel Spacing="8">
                <TextBlock Text="Saved Layouts"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="NoSavedLabel"
                           Text="No saved layouts yet."
                           FontSize="12"
                           Opacity="0.5"/>
                <StackPanel x:Name="SavedList"
                            Spacing="8"
                            Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Vertical separator -->
        <Border Grid.Column="1"
                Width="1"
                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                Margin="0,4,14,4"/>

        <!-- ===== RIGHT: Editor ===== -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,4,0,4">
            <StackPanel Spacing="14">

                <!-- Editor mode label -->
                <TextBlock x:Name="EditorTitle"
                           Text="New Layout"
                           FontSize="14"
                           FontWeight="SemiBold"/>

                <!-- Grid Shape selector -->
                <StackPanel>
                    <TextBlock Text="Grid Shape"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <Grid x:Name="ShapeGrid"
                          HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="Cell00" Grid.Row="0" Grid.Column="0"
                                      Style="{StaticResource ShapeCellStyle}"
                                      Click="OnShapeCellClicked" Tag="0,0"/>
                        <ToggleButton x:Name="Cell01" Grid.Row="0" Grid.Column="1"
                                      Style="{StaticResource ShapeCellStyle}"
                                      Click="OnShapeCellClicked" Tag="0,1"/>
                        <ToggleButton x:Name="Cell02" Grid.Row="0" Grid.Column="2"
                                      Style="{StaticResource ShapeCellStyle}"
                                      Click="OnShapeCellClicked" Tag="0,2"/>

                        <ToggleButton x:Name="Cell10" Grid.Row="1" Grid.Column="0"
                                      Style="{StaticResource ShapeCellStyle}"
                                      Click="OnShapeCellClicked" Tag="1,0"/>
                        <ToggleButton x:Name="Cell11" Grid.Row="1" Grid.Column="1"
                                      Style="{StaticResource ShapeCellStyle}"
                                      Click="OnShapeCellClicked" Tag="1,1"/>
                        <ToggleButton x:Name="Cell12" Grid.Row="1" Grid.Column="2"
                                      Style="{StaticResource ShapeCellStyle}"
                                      Click="OnShapeCellClicked" Tag="1,2"/>

                        <ToggleButton x:Name="Cell20" Grid.Row="2" Grid.Column="0"
                                      Style="{StaticResource ShapeCellStyle}"
                                      Click="OnShapeCellClicked" Tag="2,0"/>
                        <ToggleButton x:Name="Cell21" Grid.Row="2" Grid.Column="1"
                                      Style="{StaticResource ShapeCellStyle}"
                                      Click="OnShapeCellClicked" Tag="2,1"/>
                        <ToggleButton x:Name="Cell22" Grid.Row="2" Grid.Column="2"
                                      Style="{StaticResource ShapeCellStyle}"
                                      Click="OnShapeCellClicked" Tag="2,2"/>
                    </Grid>
                    <TextBlock x:Name="ShapeLabel"
                               Text="Click a cell to choose shape"
                               FontSize="11"
                               Opacity="0.6"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Slot assignment (shown after shape chosen) -->
                <StackPanel x:Name="SlotSection"
                            Visibility="Collapsed">
                    <TextBlock Text="Assign Projects to Slots"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <Grid x:Name="SlotGrid"/>
                    <TextBlock Text="Drag slots to rearrange"
                               FontSize="11"
                               Opacity="0.5"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Layout name input -->
                <StackPanel x:Name="NameSection"
                            Visibility="Collapsed">
                    <TextBlock Text="Layout Name"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="LayoutNameBox"
                             PlaceholderText="e.g. Dev Setup, Frontend, Backend…"
                             MaxLength="60"/>
                </StackPanel>

                <!-- Delete button — shown in edit mode only -->
                <Button x:Name="DeleteButton"
                        Visibility="Collapsed"
                        Content="Delete Layout"
                        Click="OnDeleteCurrentClicked"
                        Foreground="Salmon"
                        Margin="0,4,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
