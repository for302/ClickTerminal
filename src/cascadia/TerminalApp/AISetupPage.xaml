<ContentDialog x:Class="TerminalApp.AISetupPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               CloseButtonText="Cancel"
               DefaultButton="Primary"
               PrimaryButtonText="Done"
               Title="AI Tool Setup"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ContentDialogSmokeBrush" Color="#99000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ContentDialogSmokeBrush" Color="#99000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ContentDialogSmokeBrush" Color="#99000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <StackPanel x:Name="SetupContentPanel"
                MinWidth="420"
                Spacing="12">

        <!-- Tool Selector -->
        <TextBlock FontWeight="SemiBold"
                   Text="AI Tool" />
        <ComboBox x:Name="ToolComboBox"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="0"
                  SelectionChanged="_ToolSelectionChanged">
            <ComboBoxItem Content="Claude Code (Anthropic)" />
            <ComboBoxItem Content="Codex CLI (OpenAI)" />
            <ComboBoxItem Content="Gemini CLI (Google)" />
        </ComboBox>

        <!-- Status + Install button row -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center" />
            <Button x:Name="InstallButton"
                    Grid.Column="1"
                    Content="Install"
                    Click="_InstallClicked"
                    Visibility="Collapsed" />
        </Grid>

        <!-- Install command hint -->
        <Border x:Name="InstallCommandBorder"
                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="4"
                Padding="8,6"
                Visibility="Collapsed">
            <TextBlock x:Name="InstallCommandText"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="11"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Install log (shown while installing) -->
        <ScrollViewer x:Name="LogScrollViewer"
                      MaxHeight="160"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <TextBlock x:Name="LogTextBlock"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="11"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap" />
        </ScrollViewer>

        <!-- Auth section (shown when tool is installed) -->
        <StackPanel x:Name="AuthSection"
                    Spacing="8"
                    Visibility="Collapsed">
            <TextBlock FontWeight="SemiBold"
                       Text="Authentication" />

            <!-- OAuth tools (Claude, Codex): show instruction text -->
            <TextBlock x:Name="OAuthText"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <!-- API Key tools (Gemini): show input field -->
            <StackPanel x:Name="ApiKeySection"
                        Spacing="6"
                        Visibility="Collapsed">
                <TextBlock Text="API Key" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyBox"
                                 Grid.Column="0"
                                 PlaceholderText="Paste API key here" />
                    <Button x:Name="SaveKeyButton"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Content="Save"
                            Click="_SaveKeyClicked" />
                </Grid>
                <TextBlock x:Name="KeySavedText"
                           Text="Saved to Windows Credential Manager"
                           Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</ContentDialog>
